# Copy this file to .env and fill in real values

# Secret used to sign JWT auth tokens - change this to a long random string
JWT_SECRET=change-this-to-a-long-random-secret

# SQLite by default. Works fully offline - no external DB server needed.
DATABASE_URL=sqlite:///./engitwin.db

# --- AI Assistant ---
# Which provider to use right now: "anthropic" (online) or "local" (later, offline)
AI_PROVIDER=anthropic

# Your Anthropic API key (get one at https://console.anthropic.com/)
ANTHROPIC_API_KEY=your-api-key-here

# Model to use for the AI lab assistant
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Local provider (for later, when you switch to fully offline) ---
# URL of a local model server, e.g. Ollama running at http://localhost:11434
LOCAL_AI_URL=http://localhost:11434/api/generate
LOCAL_AI_MODEL=llama3
